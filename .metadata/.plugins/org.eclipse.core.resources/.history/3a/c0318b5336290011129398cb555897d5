package com.oops;
class DNode{
	DNode prev;
	DNode next;
	String data;
	
	
		DNode(String data){
			this.prev = null;
			this.next = null;
			this.data = data;
		}
}

public class DlinkedList {
	static DNode head;
	static DNode tail;

	
	static void printForward(){
		DNode temp = head;
		while(temp != null) {
			System.out.print(temp.data);
			if(temp.next != null) {
				System.out.print(" <--> ");
			}
			temp = temp.next;
		}
	}
	static void printBackword() {
		DNode temp = tail;
		while(temp != null) {
			System.out.print(temp.data);
			if(temp.prev != null) {
				System.out.print(" <--> ");
			}
			temp = temp.prev;
		}
	}
	
	static void addAtFirst(String data) {
		DNode node = new DNode(data);
		if(head == null ) {
			head = tail = node;
			return;
		}
		head.prev = node;
		node.next = head;
		head = node;
		
	}
	static void reverse() {
		DNode current = head;
		DNode temp = null;
		while(current != null) {
			temp = current.prev;
            current.prev = current.next;
            current.next = temp;
            current = current.prev;
		}
		if(temp != null) {
			
			head = temp.prev;
		}
		// Update Tail
//		tail = head;
//		while(tail != null || tail.next != null) {
//			tail = tail.next;
//		}
	}
