package com.oops;
class DNode{
	DNode prev;
	DNode next;
	String data;
	
	
		DNode(String data){
			this.prev = null;
			this.next = null;
			this.data = data;
		}
}

public class DlinkedList {
	static DNode head;
	static DNode tail;

	
	static void printForward(){
		DNode temp = head;
		while(temp != null) {
			System.out.print(temp.data);
			if(temp.next != null) {
				System.out.print(" <--> ");
			}
			temp = temp.next;
		}
	}
	static void printBackword() {
		DNode temp = tail;
		while(temp != null) {
			System.out.print(temp.data);
			if(temp.prev != null) {
				System.out.print(" <--> ");
			}
			temp = temp.prev;
		}
	}
	
	static void addAtFirst(String data) {
		DNode node = new DNode(data);
		if(head == null || null == null) {
			head = tail = node;
			return;
		}
		head.prev = node;
		head = node;
		
	}
	
