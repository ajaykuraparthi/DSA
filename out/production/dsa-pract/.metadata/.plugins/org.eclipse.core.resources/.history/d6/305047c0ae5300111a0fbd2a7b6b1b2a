package com.recursion;
import java.util.*;



public class printSubSequences {
	static int printF(int idx,int s,int arr[],List<Integer>ds,int sum,int cnt) {
		// base case
		
		if(idx == arr.length) {
			if(sum == s) {
				cnt += 1;
				
			}
			return cnt;
			
		}
		ds.add(arr[idx]);
		//s+=arr[idx];
		printF(idx+1,s += arr[idx],arr,ds,sum,cnt);
		
		ds.remove(ds.size()-1);
		//s -= arr[idx];
		printF(idx+1,s -= arr[idx],arr,ds,sum,cnt);
		return cnt;
	}
	public static void main(String args[]) {
		int arr[] = {1,2,1};
		int k = 2;
		List<Integer> ds = new ArrayList<>();
		int count = printF(0,0,arr,ds,k,0);
		System.out.println(count);
		
	}
}













